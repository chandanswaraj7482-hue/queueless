generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
  clinics   Clinic[]
  patients  Patient[]
  users     User[]
}

model Clinic {
  id                String        @id @default(uuid())
  tenantId          String
  name              String
  slug              String        @unique
  address           String
  logoUrl           String?
  timezone          String        @default("Asia/Kolkata")
  openingHours      String        @default("09:00 - 20:00")
  contactPhone      String?
  followUpDays      Int           @default(15)
  settings          String?
  adminPassword     String?       @default("admin123")
  receptionPassword String?       @default("reception123")
  createdAt         DateTime      @default(now())
  appointments      Appointment[]
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctors           Doctor[]
  payments          Payment[]
  queueEntries      QueueEntry[]
  services          Service[]
  userRoles         UserRole[]
}

model User {
  id        String     @id @default(uuid())
  tenantId  String
  name      String
  email     String     @unique
  mobile    String?
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())
  doctor    Doctor?
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     UserRole[]
}

model UserRole {
  id       String @id @default(uuid())
  userId   String
  clinicId String
  role     String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId, role])
}

model Doctor {
  id           String        @id @default(uuid())
  clinicId     String
  userId       String?       @unique
  displayName  String
  specialty    String
  roomNumber   String?
  active       Boolean       @default(true)
  pin          String?       @default("1234")
  password     String?       @default("doctor123")
  appointments Appointment[]
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  queueEntries QueueEntry[]
}

model Service {
  id              String        @id @default(uuid())
  clinicId        String
  name            String
  durationMinutes Int           @default(15)
  fee             Float         @default(500.0)
  active          Boolean       @default(true)
  appointments    Appointment[]
  queueEntries    QueueEntry[]
  clinic          Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model Patient {
  id               String        @id @default(uuid())
  tenantId         String
  name             String
  mobile           String
  email            String?
  age              Int?
  gender           String?
  bloodGroup       String?
  address          String?
  emergencyContact String?
  createdAt        DateTime      @default(now())
  appointments     Appointment[]
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queueEntries     QueueEntry[]
}

model Appointment {
  id            String      @id @default(uuid())
  clinicId      String
  patientId     String
  doctorId      String?
  serviceId     String?
  scheduledAt   DateTime
  status        String      @default("BOOKED")
  paymentStatus String      @default("PENDING")
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor        Doctor?     @relation(fields: [doctorId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service       Service?    @relation(fields: [serviceId], references: [id])
  queueEntry    QueueEntry?
}

model QueueEntry {
  id               String        @id @default(uuid())
  clinicId         String
  patientId        String
  doctorId         String?
  serviceId        String?
  appointmentId    String?       @unique
  token            String
  publicToken      String        @unique
  queueDate        String
  priority         Int           @default(0)
  visitReason      String?
  status           String        @default("WAITING")
  feeAmount        Float         @default(500.0)
  paymentStatus    String        @default("PENDING")
  isFollowUp       Boolean       @default(false)
  followUpNote     String?
  diagnosis        String?
  vitalsJson       String?
  prescriptionJson String?
  clinicalNotes    String?
  joinedAt         DateTime      @default(now())
  calledAt         DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  checkInToken     CheckInToken?
  payment          Payment?
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])
  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor           Doctor?       @relation(fields: [doctorId], references: [id])
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service          Service?      @relation(fields: [serviceId], references: [id])
}

model CheckInToken {
  id           String     @id @default(uuid())
  queueEntryId String     @unique
  tokenHash    String
  expiresAt    DateTime
  usedAt       DateTime?
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String      @id @default(uuid())
  clinicId          String
  queueEntryId      String?     @unique
  provider          String      @default("CASH")
  providerOrderId   String?
  providerPaymentId String?
  amount            Float
  currency          String      @default("INR")
  status            String      @default("COMPLETED")
  createdAt         DateTime    @default(now())
  clinic            Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  queueEntry        QueueEntry? @relation(fields: [queueEntryId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    String?
  timestamp   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model QueuelessReview {
  id           String   @id @default(uuid())
  clinicId     String?
  queueEntryId String?
  patientName  String?
  rating       Int      @default(5)
  feedbackTags String?
  comment      String?
  createdAt    DateTime @default(now())
}
